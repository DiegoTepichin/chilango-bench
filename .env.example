# ==============================================================================
# chilango-bench environment variables
# ==============================================================================

# API Keys & Endpoints (Used by OpenAIRunner and OpenAI-compatible providers)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama (OpenAI-compatible endpoint) used by --provider ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# Benchmark Runner Configuration
CHILANGO_TIMEOUT_SECONDS=30.0
CHILANGO_MAX_RETRIES=3
